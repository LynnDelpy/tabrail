--- tmux-mouse.conf
+++ tmux-mouse.conf
@@ -2,7 +2,8 @@
 # Drag, double click (word; paths and URLs stay whole) or triple click (line) copies and stays
 # highlighted, a scrolled-back view stays put. A click clears it and leaves copy mode unless scrolled
 # back; middle click pastes PRIMARY. Shift+drag skips tmux: Konsole's own selection, across panes.
-# Panes that take the mouse (nvim, Claude fullscreen) keep it.
+# Panes that take the mouse (nvim, Claude fullscreen) keep it. A double click into tabrail's reader
+# bar grows it or shrinks it again (tabrail-reader grow), as tabrail.tmux binds it.
 # CLIPBOARD is set by Konsole via OSC 52 (set-clipboard on), xsel only sets PRIMARY: with xsel on
 # CLIPBOARD as well, two owners raced on every copy.
 set -s copy-command 'xsel -ip'
@@ -18,6 +19,6 @@
 bind -T copy-mode-vi MouseDown1Pane select-pane \; if -F "#{scroll_position}" { send -X clear-selection } { send -X cancel }
 bind -T copy-mode-vi DoubleClick1Pane select-pane \; send -X select-word \; send -X copy-pipe-no-clear
 bind -T copy-mode-vi TripleClick1Pane select-pane \; send -X select-line \; send -X copy-pipe-no-clear
-bind -n DoubleClick1Pane select-pane -t = \; if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-word ; send -X copy-pipe-no-clear }
+bind -n DoubleClick1Pane if -F -t = "#{@reader}" { select-pane -t = ; run -b -t = "#{@tabrail_dir}/tabrail-reader grow '#{window_id}'" } { select-pane -t = ; if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-word ; send -X copy-pipe-no-clear } }
 bind -n TripleClick1Pane select-pane -t = \; if -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" { send -M } { copy-mode -H ; send -X select-line ; send -X copy-pipe-no-clear }
 bind -n MouseDown2Pane select-pane -t = \; if -F "#{mouse_any_flag}" { send -M } { copy-mode -q ; run "xsel -op | tmux load-buffer -b primary - && tmux paste-buffer -p -d -b primary -t #{pane_id}" }
--- tmux.conf
+++ tmux.conf
@@ -78,14 +78,14 @@
 
 # extrakto (prefix e): fuzzy-pick a path, URL or COO from the screen. yank: y copies (PRIMARY via
 # xsel, CLIPBOARD via OSC 52). resurrect + continuum: restore when tmux starts; Claude tabs come
-# back with --continue, sidebars restart in their saved panes (tabrail-tmux ensure waits for the
-# restore to finish).
+# back with --continue, sidebars and the reader bar's slots (tabrail-slot) restart in their saved
+# panes (tabrail-tmux ensure waits for the restore to finish).
 set -g @extrakto_key 'e'
 set -g @extrakto_split_direction 'p'
 set -g @override_copy_command 'xsel -ip'
 set -g @yank_with_mouse off
 set -g @resurrect-capture-pane-contents 'on'
-set -g @resurrect-processes '"~claude->withproxy claude --continue" "~release/tabrail->~/Dev/tabrail/target/release/tabrail"'
+set -g @resurrect-processes '"~claude->withproxy claude --continue" "~release/tabrail->~/Dev/tabrail/target/release/tabrail" "~tabrail-slot->~/Dev/tabrail/tabrail-slot"'
 set -g @continuum-restore 'on'
 set -g @continuum-save-interval '15'
 run-shell ~/.tmux/plugins/tmux-yank/yank.tmux
