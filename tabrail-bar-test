#!/usr/bin/env bash
# Tests for the reader bar sized by tabrail-chat in it (src/chat/bar.rs, tmux.rs; tabrail-reader size):
# tabrail-chat against the fake claude as @tabrail_reader, on throwaway tmux servers (tabrail-test-lib,
# tabrail-chat-test-lib's helpers on the bar's pane C). One line per check, exits 1 if one failed.
L=bar HELPERS_ONLY=1
source "$(dirname "$(readlink -f "$0")")/tabrail-chat-test-lib"
echo "cd $T/work && TABRAIL_CHAT_CLAUDE=$R/tabrail-chat-fake TABRAIL_CHAT_FAKE_LOG=$T" \
  "exec $R/target/release/tabrail-chat" > "$T/reader"
sed -i "s|^set -g @tabrail_reader .*|set -g @tabrail_reader 'sh $T/reader'|" "$T/conf"
serve; settle; C=$(rd)
h() { rd '#{pane_height}'; }
up() { press 158 46; settle 0.7; }     # the bar's ▲ and ▼, at the end of the window's last row
down() { press 160 46; settle 0.7; }
x=$(printf 'x%.0s' {1..500})
check "the reader: 4 rows, ▲ ▼ at its last row's right end" '[[ $(h) == 4 && $(row 4) == "❯ type to ask"*"▲ ▼" ]]'
click 5 44; t send-keys -t "$C" -l "$x"; settle
check "typing 500 characters: input on 4 rows, the bar 8 (4 input + 1 conversation, rounded up)" \
  '[[ $(h) == 8 && $(row 5) == "❯ x"* && $(row 8) == x*"▲ ▼" ]]'
keys C-c; t send-keys -t "$C" -l 'lines 20'; t send-keys -t "$C" Enter
for i in {1..50}; do echo "$(date +%s%N) $(h)"; sleep 0.05; done > "$T/heights"
# only up, a multiple of 4 or the third, each 0.4 s or more after the one before: the changes, else fails
steps() { awk '$2 != h { if (h && ($2 < h || $2 % 4 && $2 != 15 || c && $1 - c < 4e8)) bad = 1
                         if (h) { c = $1; n++ } h = $2 } END { if (bad) exit 1; print n }' "$T/heights"; }
check "streaming 20 lines: steps of 4 up to 15 rows (a third of 46), at most one resize per 500 ms" \
  '[[ $(h) == 15 && $(steps) -ge 2 && $(tail -1 "$T/heights") == *" 15" ]]'
rm -f "$T/go"; ask 'lines 8 more'; settle; b=$(h)
click 100 10; touch "$T/go"; settle
check "away: 12 rows, the own pane clicked: 4 rows; more answer text: still 4" \
  '[[ $b == 12 && $(h) == 4 && $(row 3) == "more 8" ]]'
click 5 44
check "back: clicked into, nothing typed: still 4 rows" '[[ $(rd "#{pane_active} #{pane_height}") == "1 4" ]]'
hs=; for i in 1 2 3 4 5; do up; hs+=" $(h)"; done; down; hs+=" $(h)"
check "▲ five times, then ▼: 11 18 25 30 30 rows, then 23" '[[ $hs == " 11 18 25 30 30 23" ]]'
down; down; down; hs=$(h); down
check "▼ down to 4 rows; at 4 it stays 4" '[[ $hs == 4 && $(h) == 4 ]]'
rm -f "$T/go"; t send-keys -t "$C" -l 'lines 3 more'; settle 0.5
check "typing a short question after a long answer (17 rows): still 4 rows" '[[ $(h) == 4 ]]'
keys Enter; m=$(h); up; b=$(h); touch "$T/go"; settle
check "a size set by ▲ holds: 8 rows after Enter, ▲ 15; more answer text: still 15" \
  '[[ $m == 8 && $b == 15 && $(h) == 15 && $(row 14) == "more 3" ]]'
ask hi; settle 0.5
check "the next question: its own height again, 4 rows" '[[ $(h) == 4 && $(row 3) == "hi two" ]]'
drag() { o send-keys -t o -l "$E[<0;$1;$2M" "$E[<32;$1;$2M" "$E[<32;$3;$4M" "$E[<0;$3;$4m"; settle; }
drag 1 45 6 45; b=$(t show-buffer 2>/dev/null); drag 2 30 9 30
check "a drag over the bar's text copies it; one in the sidebar goes to it, neither left in copy mode" \
  '[[ $b == "hi two" && -z $(t list-panes -a -F "#{pane_in_mode}" | grep 1) && $(h) == 4 ]]'
click 100 10; drag 100 42 100 30
check "the bar's border dragged up 12 rows: still 4 rows" '[[ $(h) == 4 ]]'
ask tools; settle 0.5
check "a reply after tool calls: ❯ tools, the answer, the input (not the 3 rows of narration): 4 rows" \
  '[[ $(h) == 4 && $(row 3) == "found it" ]]'
up; click 100 10; click 5 44; t send-keys -t "$C" -l "$x"; settle
check "▲, the own pane clicked (4 rows), back, typing: its own height again, 8 rows" '[[ $(h) == 8 ]]'
keys C-c; ask hi; rm -f "$T/go"; ask 'lines 1 more'; r0=$(row 4); t send-keys -t "$C" -l "${x:0:152}"; settle 0.5
r1=$(row 4); t send-keys -t "$C" -l 1234; settle 0.5; r2=$(row 4); press 158 46; settle 0.7
check "a turn running: timer and ▲ ▼; 152 characters typed: ▲ ▼ only; 156: none, a click there does nothing" \
  '[[ $r0 == *"… "*"s ▲ ▼" && $r1 == *x" "*"▲ ▼" && $r1 != *…* && $r2 != *▲* && $r2 != *…* && $(h) == 4 ]]'
keys C-c; touch "$T/go"; settle
dblclick 5 44
check "double-click into the bar: unchanged; tabrail binds no double-click" \
  '[[ $(rd "#{pane_height} #{pane_active}") == "4 1" && $(t list-keys -T root DoubleClick1Pane) != *tabrail* ]]'
t resize-pane -Z -t "$C"; t send-keys -t "$C" -l "$x"; settle; z=$(rd '#{window_zoomed_flag}')
t resize-pane -Z -t "$C"; settle 0.5
check "zoomed: typing resizes nothing, the tab stays zoomed" '[[ $z == 1 && $(h) == 4 ]]'
keys C-c; f1=$(fixed :1) f3=$(fixed :3); rm -f "$T/go"; ask 'lines 8 more'; settle; b=$(h)
t select-window -t :3; settle; touch "$T/go"; settle
check "tab switch at 12 rows: 4 rows across tab 3's bottom, more text: still 4; tabs 3 and 1 (slot 4) unchanged" \
  '[[ $b == 12 && $(at) == "3 160x4 0,42" && $(row 3) == "more 8" && $(fixed :3) == "$f3" && $(fixed :1) == "$f1" ]]'
t select-window -t :1; settle
check "and back to tab 1: 4 rows there; no pane of tab 1 or 3 resized" \
  '[[ $(at) == "1 160x4 0,42" && $(fixed :1) == "$f1" && $(fixed :3) == "$f3" ]]'
for w in 2 3 1 3 2; do t select-window -t ":$w"; done; settle   # their follows queue on the lock
check "5 tab switches at once: the bar across the last one's bottom, one slot or bar per tab, slots 160x4 there" \
  '[[ $(at) == "2 160x4 0,42" && $(marked) == "1 1 1 " &&
     $(t list-panes -a -f "#{@reader_slot}" -F "#{pane_width}x#{pane_height} #{pane_at_bottom}" | sort -u) == "160x4 1" ]]'
t select-window -t :1; settle
mkdir -p "$T/tmux-resurrect/scripts"; echo 'sleep 3' > "$T/tmux-resurrect/scripts/restore.sh"
TMUX=$(sock),0,0 bash "$T/tmux-resurrect/scripts/restore.sh" & settle 0.5
t select-window -t :2; settle; d=$(at); wait $!; t select-window -t :3; settle; e=$(at); t select-window -t :1; settle
check "while resurrect restores, a tab switch leaves the bar in place; after it, the bar follows" \
  '[[ $d == "1 "* && $e == "3 "* && $(at) == "1 "* ]]'
p=$(own :1); t respawn-pane -k -t "$p" "printf tabrailword; exec sleep 99"; settle; dblclick 30 1
check "double-click on a word in an own pane: tmux's own, the word copied; the bar unchanged" \
  '[[ $(t show-buffer 2>/dev/null) == tabrailword && $(h) == 4 ]]'
t respawn-pane -k -t "$p" -e "TABRAIL_CHAT_CLAUDE=$R/tabrail-chat-fake" -e "TABRAIL_CHAT_FAKE_LOG=$T" \
  "$R/target/release/tabrail-chat"; settle 4; ph=$(t display -p -t "$p" '#{pane_height}')
t send-keys -t "$p" -l "$x"; settle; screen=$(t capture-pane -p -t "$p")
check "tabrail-chat in an ordinary pane: no buttons, no resize" \
  '[[ $screen == *"❯ x"* && $screen != *▲* && $(t display -p -t "$p" "#{pane_height}") == "$ph" && $(h) == 4 ]]'
check "@sidebar_width never written" '[[ -z $(t show -gv @sidebar_width 2>/dev/null) ]]'
check "no failure shown in any pane" '[[ -z $(t list-panes -a -F "#{pane_in_mode}" | grep 1) ]]'
exit $((fails > 0))
