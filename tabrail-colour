#!/usr/bin/env bash
# A group's colour (the group menu's Colour…, src/menu.rs): palette's swatches, each the group's icon
# and name on that tint, in tabrail-pick's search list in a popup; the pick goes into column 2 of the
# group's line in the groups file. Called as  tabrail-colour GROUP CLIENT;  the popup runs
# tabrail-colour --pick GROUP LISTFILE.
D=$(dirname "$(readlink -f "$0")")
CONF=$(tmux show -gv @tabrail_groups 2>/dev/null)
CONF=${CONF:-$D/groups.conf}

if [[ $1 == --pick ]]; then
  group=$2
  tint=$("$D/tabrail-pick" "Colour for $group?" < "$3"); rm -f "$3"
  [[ -n $tint ]] || exit 0
  # The group's line as src/groups.rs reads it (not a comment, even indented; 3 fields or more, the
  # first of its name), its field 2 replaced in place; written like tabrail-groups move_group: through
  # a symlink, mode kept, renamed into place, and only if exactly one line changed
  file=$(readlink -f "$CONF") && new="$file.new.$$" || exit 0
  if awk -v g="$group" -v t="$tint" '
      !done && !/^[ \t]*#/ && NF >= 3 && $1 == g "" {
        match($0, /^[ \t]*[^ \t]+[ \t]+/)
        $0 = substr($0, 1, RLENGTH) t substr($0, RLENGTH + length($2) + 1); done = 1 }
      { print }
      END { exit !done }' "$file" 2>/dev/null > "$new" &&
     [[ $(diff <(awk 1 "$file") "$new" | grep -c '^[<>]') == 2 ]] &&
     chmod --reference="$file" "$new" && mv "$new" "$file"
  then tmux set-buffer -b sidebar-refresh x   # the sidebars redraw
  else rm -f "$new"; fi
  exit 0
fi

group=$1 client=$2
read -r tint icon < <(awk -v g="$group" '!/^[ \t]*#/ && NF >= 3 && $1 == g "" { print $2, $3; exit }' "$CONF")

# One line per colour: its hex, the swatch (the header's bold text on it), then the part searched: its
# name and whether the group has it now
list=$(mktemp /tmp/tabrail-colour.XXXXXX)
while read -r hex name; do
  mark=; [[ ${hex,,} == "${tint,,}" ]] && mark=$' \e[2m· current\e[0m'
  printf '%s\t\e[48;2;%d;%d;%dm\e[1;38;2;205;214;244m %s %s \e[0m\t %s%s\n' "$hex" \
    "0x${hex:1:2}" "0x${hex:3:2}" "0x${hex:5:2}" "$icon" "$group" "$name" "$mark"
done < "$D/palette" > "$list"
rows=$(wc -l < "$list")
read -r height width < <(tmux display -p -c "$client" '#{client_height} #{client_width}')
# rows + border (2), search line, footer and its rule (2); no larger than the terminal, fzf scrolls
tmux display-popup -c "$client" -B -E -w $(( width < 60 ? width : 60 )) \
  -h $(( rows + 5 < height ? rows + 5 : height )) "$0" --pick "$group" "$list" || rm -f "$list"
