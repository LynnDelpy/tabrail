#!/usr/bin/env bash
# Tests for a group's colour (tabrail-colour, palette, the group menu's Colour…, New group…'s tint) on
# throwaway tmux servers (tabrail-test-lib), the groups file a symlink to a temp copy: Colour… in the
# menus (not Default's, not a name clean() changes), New group… takes the first palette colour no group
# uses (in any case), the picker's swatches and current mark, its search on colour names alone, the
# pick in column 2 alone (link and mode kept), every sidebar redrawn, Esc, a hand-written tint, the
# group renamed while the picker is open, the same tint again, a 50x20 client. One line per check,
# exits 1 if one failed.
L=colour
source "$(dirname "$(readlink -f "$0")")/tabrail-test-lib"
mkdir "$T/web" "$T/infra" "$T/dirty" "$T/real"
F=$T/real/groups.conf
printf '%s\n' "# a comment   with  spaces" "Website   #283147  ◆  $T/web" "" "Infra	#3B2F2A	▲	$T/infra" \
  "Q'a #3b2a3a ■ $T/dirty" "# Website #000000 x" > "$F"
chmod 640 "$F"; ln -s "$F" "$T/groups.conf"
sed -i '/@tabrail_reader/d' "$T/conf"   # no reader bar: not what this tests
printf '%s\n' "set -g @tabrail_groups '$T/groups.conf'" "set -as terminal-features ',tmux*:RGB'" >> "$T/conf"
outer() {   # main shown in the outer server at COLSxROWS
  o -f /dev/null new -d -s o -x "$1" -y "$2" "TMUX= tmux -L tabrail-$L attach -t main; sleep 600"
  o set -g status off; settle 3
}
inner; for d in web infra dirty; do t new-window -d -c "$T/$d"; done; outer 160 46
shown() { o capture-pane -p -t o:0; }
menu() {   # right-click the row holding TEXT, menu open
  local y; y=$(shown | grep -n -m1 -- "$1" | cut -d: -f1)
  o send-keys -t o:0 -l $'\e[<2;5;'"$y"M; o send-keys -t o:0 -l $'\e[<2;5;'"$y"m; settle 0.7
}
keys() { o send-keys -t o:0 -l "$1"; settle "${2:-1}"; }
key() { o send-keys -t o:0 "$1"; settle "${2:-1.5}"; }
swatches() { grep -c "│ [ ❯]  ◆ Website " <<<"$1"; }                    # picker rows for Website
row() { t capture-pane -ep -t "$(side "$1")" | grep -m1 -- "$2"; }         # a sidebar's row, escapes
notemp() { [[ -z $(ls "$T/real" | grep new) ]]; }

menu "▾ ◆ Website"; m=$(shown); keys q 0.5
check "Website's menu: Colour… right after Rename group" '[[ $m == *"Rename group"*"Colour…"*Fold* ]]'
menu "• Default"; m=$(shown); keys q 0.5
check "Default's menu: no Colour…" '[[ $m == *Fold* && $m != *Colour* ]]'
menu "■ Q'a"; m=$(shown); keys q 0.5
check "a name clean() changes (Q'a): no Colour…" '[[ $m == *Fold* && $m != *Colour* ]]'

menu "▾ ◆ Website"; keys g; keys Ops; key Enter 2
check "New group…: the first palette colour unused, #3B2F2A taken as Brown ($(grep ^Ops "$F"))" \
  '[[ $(grep ^Ops "$F") == "Ops       #2a3b2f  "* ]]'
t kill-window -t "$(t list-windows -t main -F '#{window_id} #{@group}' | awk '$2 == "Ops" { print $1 }')"
sed -i '/^Ops/d' "$F"; cp "$F" "$T/orig"; t select-window -t main:1; settle

menu "▾ ◆ Website"; keys c 1.5; p=$(shown); e=$(o capture-pane -ep -t o:0)
check "picker: title, 25 swatch rows, Blue alone marked current" \
  '[[ $p == *"Colour for Website?"* && $(swatches "$p") == 25 && $(grep -c "· current" <<<"$p") == 1 &&
     $p == *" Blue · current"* ]]'
check "swatches: the tint under the header's bold #cdd6f4" '[[ $e == *"48;2;65;89;96m"* && $e == *"38;2;205;214;244m"* ]]'
keys web; p=$(shown)
check "typing the group's own name (web): no swatch row" '[[ $p == *"Colour for Website?"* && $(swatches "$p") == 0 ]]'
key C-u 0.3; keys te; p=$(shown)
check "te: five rows, the three teal ones first" \
  '[[ $(swatches "$p") == 5 && $(grep "│ [ ❯]  ◆ Website " <<<"$p" | head -3 | grep -c " Teal") == 3 ]]'
key C-u 0.3; keys 'teal d'; p=$(shown)
check "teal d: one row, Teal deep" '[[ $(swatches "$p") == 1 && $p == *"Teal deep"* ]]'
key Enter
check "Enter: Website's column 2 is #415960" '[[ $(grep "^Website" "$F") == "Website   #415960  ◆  $T/web" ]]'
d=$(diff "$T/orig" "$F" | grep '^[<>]' | tr '\n' '|')
check "only Website's line changed" '[[ $d == "< Website   #283147  ◆  $T/web|> Website   #415960  ◆  $T/web|" ]]'
check "the groups file still a symlink, mode 640, no temp file" '[[ -L $T/groups.conf && $(stat -c %a "$F") == 640 ]] && notemp'
for w in 1 2 3 4; do
  t select-window -t main:$w; settle 1.2
  check "tab $w's sidebar: Website on 48;2;65;89;96" '[[ $(row main:$w "◆ Website") == *"48;2;65;89;96m"* ]]'
done
t select-window -t main:1; settle

cp "$F" "$T/before"; menu "▾ ▲ Infra"; keys c 1.5; p=$(shown); keys pl; key Escape
check "Infra's #3B2F2A marks Brown; Esc: file identical, popup gone" \
  '[[ $p == *" Brown · current"* && $(shown) != *"Colour for"* ]] && cmp -s "$T/before" "$F"'
sed -i 's/#3B2F2A/#123456/' "$F"; menu "▾ ▲ Infra"; keys c 1.5; p=$(shown); keys plum; key Enter
check "a hand-written tint marks no row; picking Plum still works" \
  '[[ $p == *"Colour for Infra?"* && $p != *"· current"* && $(grep ^Infra "$F") == "Infra	#3b2a3a	▲	$T/infra" ]]'

cp "$F" "$T/before"; menu "▾ ◆ Website"; keys c 1.5; keys olive
sed -i 's/^Website /Webcite /' "$F"; cp "$F" "$T/renamed"; key Enter
check "the group renamed while the picker is open: file untouched, no temp" 'cmp -s "$T/renamed" "$F" && notemp'
cp "$T/before" "$F"; t set-buffer -b sidebar-refresh x; settle

menu "▾ ◆ Website"; keys c 1.5; p=$(shown); keys 'teal d'; key Enter
check "Teal deep marked current; picking it again writes nothing" '[[ $p == *" Teal deep · current"* ]] && cmp -s "$T/before" "$F"'

o kill-server; sleep 0.5; outer 50 20
menu "▾ ◆ Website"; keys c 1.5; p=$(shown)
check "a 50x20 client: the popup fits (both borders), fzf scrolls" \
  '[[ $(head -1 <<<"$p") == "╭"*"Colour for Website?"*"╮" && $(tail -1 <<<"$p") == "╰"*"╯" && $(swatches "$p") -lt 25 ]]'
key Escape
check "a 50x20 client, Esc: file identical" 'cmp -s "$T/before" "$F"'
exit $((fails > 0))
