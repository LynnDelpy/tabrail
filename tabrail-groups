#!/usr/bin/env bash
# The groups file (the file @tabrail_groups names, else groups.conf): its tree and its writers, for
# tabrail's menus and group drags (tabrail-name, tabrail-move, src/drag.rs); also usable by hand:
#   tree                     per group line in file order: its depth (0 top-level), name and icon,
#                            tab-separated; a group's parent is the nearest group line above it with
#                            less leading whitespace (a space or a tab counts one), as src/groups.rs reads it
#   folder GROUP             GROUP's first folder, else the first of its nearest ancestor that has
#                            folders, else nothing (tabrail-act new opens its tab there); ~ not expanded
#   rename-group OLD NEW     in the groups file (the line's indent and spacing kept), on its tabs, in the
#                            fold state and its timer
#   new-group NAME TARGET [PARENT]
#                            a line with a tint and an icon not used yet; with PARENT right after
#                            PARENT's subtree, one level deeper; TARGET a tab (@id) moves into the group, a
#                            sidebar pane (pID for %ID) gets a new tab in it (tabrail-groups-new)
#   move-group SRC ONTO      SRC's tree goes above ONTO's line if that is higher up, else below ONTO's
#                            tree; ONTO Default: below the last group line; siblings only
#   nest SRC PARENT          SRC's tree goes below PARENT's tree, one level deeper (both: tabrail-groups-move)
# Group lines as src/groups.rs reads them: not a comment (first non-blank character #), 3 fields or
# more, the first of a name.
D=$(dirname "$(readlink -f "$0")")
CONF=$(tmux show -gv @tabrail_groups 2>/dev/null)   # the groups: the file tmux.conf names, else ours
CONF=${CONF:-$D/groups.conf}
ICONS=(◆ ▲ ● ■ ★ ✦ ♦ ✚)
source "$D/tabrail-groups-new"    # new_group, sub_line
source "$D/tabrail-groups-move"   # move_group

refresh() { tmux set-buffer -b sidebar-refresh x 2>/dev/null; true; }   # see tabrail-tmux

tree() {   # indent[] the leading whitespace of the last group line and its ancestors
  awk '!/^[ \t]*#/ && NF >= 3 { match($0, /^[ \t]*/); while (n && indent[n] >= RLENGTH) n--
                          indent[++n] = RLENGTH; print n - 1 "\t" $1 "\t" $3 }' "$CONF"
}

folder() {   # dir[] the first folder of the last group line and its ancestors ("" if none)
  awk -v g="$1" '!/^[ \t]*#/ && NF >= 3 { match($0, /^[ \t]*/); while (n && indent[n] >= RLENGTH) n--
                 indent[++n] = RLENGTH; dir[n] = $4
                 if ($1 == g "") { while (n && dir[n] == "") n--; if (n) print dir[n]; exit } }' "$CONF"
}

# Only the name changes: the indent before it and the spacing after it stay; written through a
# symlink, mode kept, renamed into place
rename_group() {
  local old=$1 new=${2// /-} file tmp win   # one word: the groups file splits on spaces
  [[ -z $new || $old == Default || $new == Default ]] && return
  file=$(readlink -f "$CONF") && tmp="$file.new.$$" || return 0
  if awk -v o="$old" -v n="$new" '!/^[ \t]*#/ && $1 == o "" { match($0, /^[ \t]*/)
           $0 = substr($0, 1, RLENGTH) n substr($0, RLENGTH + length(o) + 1) } 1' "$file" > "$tmp" &&
     chmod --reference="$file" "$tmp" && mv "$tmp" "$file"
  then "$D/tabrail-timer" rename "$old" "$new"
  else rm -f "$tmp"; fi
  for win in $(tmux list-windows -a -F '#{window_id}'); do
    [[ $(tmux show -wv -t "$win" @group 2>/dev/null) == "$old" ]] && tmux set -w -t "$win" @group "$new"
  done
  tmux set -g @sidebar_fold "$(tmux show -gv @sidebar_fold 2>/dev/null | tr '|' '\n' |
    awk -v o="$old" -v n="$new" '$0 == o { $0 = n } 1' | paste -sd'|')"
  refresh
}

case $1 in
  tree) tree ;;
  folder) folder "$2" ;;
  rename-group) shift; rename_group "$@" ;;
  new-group) shift; new_group "$@" ;;
  move-group|nest) move_group "$@" ;;
  *) echo "usage: tabrail-groups tree | folder GROUP | rename-group OLD NEW | new-group NAME TARGET [PARENT] |" \
          "move-group SRC ONTO | nest SRC PARENT" >&2
     exit 2 ;;
esac
