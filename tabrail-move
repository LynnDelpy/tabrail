#!/usr/bin/env bash
# Move a tab to another tabrail group (prefix M, and the tab menu's "Move to group…"), picked with
# tabrail-pick in a popup sized to the list. Called as  tabrail-move WINDOW_ID CLIENT;  the popup runs
# tabrail-move --pick WINDOW_ID LISTFILE.
D=$(dirname "$(readlink -f "$0")")

if [[ $1 == --pick ]]; then
  win=$2 list=$3
  group=$("$D/tabrail-pick" -n "Move tab to which group?" < "$list"); rm -f "$list"
  [[ -n $group ]] || exit 0
  tmux set -w -t "$win" @group "$group"
  tmux set-buffer -b sidebar-refresh x   # the sidebars redraw
  exit 0
fi

win=$1 client=$2
current=$(tmux display -p -t "$win" '#{?@group,#{@group},Default}')
counts=$(tmux list-windows -a -F '#{?@group,#{@group},Default}' | sort | uniq -c)

# One line per group: the groups file's tree in order (tabrail-groups tree), indented one column per
# level (no icon), then Default
groups() {
  { "$D/tabrail-groups" tree; printf '0\tDefault\n'; } |
  while IFS=$'\t' read -r depth name _; do
    n=$(awk -v g="$name" '$2 == g { print $1 }' <<<"$counts")
    note="${n:-0} tab"; [[ ${n:-0} == 1 ]] || note+=s
    [[ $name == "$current" ]] && note+=" · current"
    printf '%s\t%*s%s  \e[2m%s\e[0m\n' "$name" "$depth" '' "$name" "$note"
  done
}

list=$(mktemp /tmp/tabrail-move.XXXXXX)
groups > "$list"
# rows + border (2) + footer and its rule (2)
tmux display-popup -c "$client" -B -E -w 60 -h $(( $(wc -l < "$list") + 4 )) "$0 --pick '$win' '$list'"
