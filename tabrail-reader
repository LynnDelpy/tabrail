#!/usr/bin/env bash
# The reader pane, a bar across the bottom of the tab, when the global option @tabrail_reader holds
# the command it runs (a chat: ~/Dev/vmConfig/journal-reader/start). One pane, marked @reader, spans
# the full width of the tab shown last, under its sidebar and own panes; every other tab holds a slot
# there (tabrail-slot, @reader_slot), an idle pane as big as the small bar, that the bar swaps places
# with: same process and conversation, no other pane resizes. Its size: tabrail-reader-size. From
# tabrail.tmux hooks and bindings and tabrail-tmux; idle while resurrect restores this server:
#   follow [SESSION]  move it to the tab SESSION shows (else the last used one); start it if it is
#                     gone, in that tab's slot, not within 10 s of the last start (@tabrail_reader_started)
#   slots [WINDOW]    a slot in every tab (or WINDOW) that holds neither a slot nor the reader
#   fit WINDOW        small while the tab's own pane is active; back across the bottom at its size if
#                     tmux moved it (layout command, terminal resize); in a tab without it, its slot
#   size PANE ROWS|up|down  tabrail-chat in the bar (PANE) sizing it: its own height or a button's step
#   away WINDOW       before WINDOW closes: move it to the tab tmux shows next
# follow and fit read @tabrail_reader in their one query (a tab switch: two tmux calls), the rest here
[[ $1 == follow || $1 == fit ]] || { CMD=$(tmux show -gv @tabrail_reader 2>/dev/null); [[ -n $CMD ]] || exit 0; }
for p in $(pgrep -u "$UID" -f '^bash [^ ]*/tmux-resurrect/scripts/restore[.]sh'); do
  grep -qaF "TMUX=${TMUX%%,*}," "/proc/$p/environ" 2>/dev/null && exit 0; done   # ensure follows
exec 8> "/tmp/tabrail-reader-$UID.lock"; flock -w 5 8 || exit 0   # one at a time (hooks burst)
D=$(dirname "$(readlink -f "$0")")
source "$D/tabrail-reader-size"   # height, fit, size, place, tall; they use reader, sidebar
source "$D/tabrail-reader-move"   # state, move: follow's one query and one chained call

# the reader's pane, its window and its height if taller than small; a window's sidebar pane
reader() { tmux list-panes -a -f '#{@reader}' -F '#{pane_id} #{window_id} #{@reader_big}' | head -1; }
sidebar() { tmux list-panes -t "$1" -f '#{@sidebar}' -F '#{pane_id}' 2>/dev/null | head -1; }
zoomed() { tmux display -p -t "$1" '#{window_zoomed_flag}'; }
# zoomed tabs stay zoomed: split-window and swap-pane unzoom them (WINDOW, its flag before)
rezoom() { [[ $2 == 1 && $(zoomed "$1") == 0 ]] && tmux resize-pane -Z -t "$1"; }

# a slot's pane across the bottom of the window of sidebar $1, not marked yet; prints it (mkslot, move)
newslot() { tmux split-window -fv -d -l "$SMALL" -t "$1" -P -F '#{pane_id}' "$D/tabrail-slot"; }
mkslot() {   # a slot across the bottom of window $2, below its sidebar $1; prints its pane
  local id was=$(zoomed "$2")
  id=$(newslot "$1") || return
  tmux set -p -t "$id" @reader_slot 1; rezoom "$2" "$was"; echo "$id"
}

slots() {   # also puts a slot out of place (a sidebar added beside it) back across the bottom
  local f='#{window_id} #{pane_id} #{?@sidebar,s,}#{?@reader_slot,l,}#{?@reader,r,}' act p win
  f+='#{?#{&&:#{pane_at_bottom},#{==:#{pane_width},#{window_width}}},,o}'   # o: out of place
  while read -r act p win; do   # from one list of panes, not three tmux calls per tab
    if [[ $act == p ]]; then place "$p" "$win"; else mkslot "$p" "$win" >/dev/null; fi
  done < <(tmux list-panes ${1:+-t} "${1:--a}" -F "$f" 2>/dev/null | awk '
    $3 ~ /s/ { side[$1] = $2 } $3 ~ /[lr]/ { has[$1] } $3 ~ /lo/ { out[$1] = $2 }
    END { for (i in side) if (i in out) print "p", out[i], i; else if (!(i in has)) print "m", side[i], i }')
}

start() {   # in window win: its slot becomes the reader (no slot: one is made first)
  local last id=$s
  last=$(tmux show -gv @tabrail_reader_started 2>/dev/null)
  (( EPOCHSECONDS - ${last:-0} < 10 )) && return
  tmux set -g @tabrail_reader_started "$EPOCHSECONDS"
  [[ -n $id ]] || id=$(mkslot "$side" "$win") || return
  tmux respawn-pane -k -t "$id" "$CMD" && tmux set -p -t "$id" @reader 1 \; set -pu -t "$id" @reader_slot
}

follow() {
  state "$1"
  [[ -n $CMD && -n $side ]] || return   # no sidebar yet: tabrail-tmux ensure follows once it has one
  if [[ -z $r ]]; then start
  elif [[ $rwin != "$win" ]]; then move
  else fit "$win"; fi
}

away() {
  local next
  state "$1"; [[ -n $r && $rwin == "$1" ]] || return
  # what tmux shows once WINDOW is gone: if it is the current tab the last one, else the one before
  # it (round), else the current tab
  next=$(tmux list-windows -t "$1" -F '#{window_id} #{window_active}#{window_last_flag}' |
    awk -v w="$1" '$1 == w { me = 1; current = substr($2, 1, 1) == 1; next }
      substr($2, 1, 1) == 1 { cur = $1 } substr($2, 2, 1) == 1 { last = $1 }
      { if (me) end = $1; else before = $1 }
      END { print !current ? cur : last ? last : before ? before : end }')
  state "$next"; [[ -n $side && -n $r ]] && move
}

case $1 in
  follow | slots | fit | size | away | grow) "$@"; exit 0 ;;   # run-shell -b shows a failure in the pane
  *) echo "usage: tabrail-reader follow [SESSION] | slots [WINDOW] | fit WINDOW |" \
          "size PANE ROWS|up|down | away WINDOW" >&2; exit 2 ;;
esac
