# shellcheck shell=bash
# The reader pane's size, sourced by tabrail-reader. Only its height changes, never the column's
# width, so the sidebar and the tab's own panes stay where they are. Small: 4 rows. Big
# (@reader_big) while it has the keyboard: 2/3 of the tab's height.

big() {   # reader $1 in window $2
  tmux set -p -t "$1" @reader_big 1
  tmux resize-pane -t "$1" -y $(( $(tmux display -p -t "$2" '#{window_height}') * 2 / 3 ))
}

small() {   # reader $1; also to put a small one back to 4 rows
  tmux resize-pane -t "$1" -y 4
  tmux set -pu -t "$1" @reader_big
}

# WINDOW: big while the reader is its active pane, small while its own pane is; the sidebar leaves
# the reader as it is. Its size is applied again either way (after a resize, tmux spreads rows).
fit() {
  local r rwin isbig zoom active
  read -r r rwin isbig < <(reader)
  [[ $rwin == "$1" ]] || return
  read -r zoom active < <(tmux display -p -t "$1" \
    '#{window_zoomed_flag} #{?@reader,reader,#{?@sidebar,sidebar,work}}')
  [[ $zoom == 1 ]] && return   # resizing would unzoom the tab
  case $active in
    reader) big "$r" "$1" ;;
    work) small "$r" ;;
    *) if [[ -n $isbig ]]; then big "$r" "$1"; else small "$r"; fi ;;
  esac
}
