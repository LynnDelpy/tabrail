# shellcheck shell=bash
# The reader bar's size, sourced by tabrail-reader. Only its height changes, never a pane's width,
# so the sidebar and the tab's own panes keep their columns. Small: SMALL rows (the chat's last
# lines and the input line), as a tab's slot always is. Taller only as tabrail-chat in it asks (size):
# its own height while it has the keyboard, or a button's step. @reader_big holds a height above
# SMALL rows until the tab's own pane takes the keyboard or the bar leaves the tab.
SMALL=4

tall() { echo $(( $(tmux display -p -t "$1" '#{window_height}') * 2 / 3 )); }   # the most, in window $1

height() {   # reader $1 to $2 rows, kept in @reader_big above SMALL; also a slot back to SMALL rows
  # @reader_big first: tabrail.tmux's window-layout-changed hook puts back any other height
  if (( $2 > SMALL )); then tmux set -p -t "$1" @reader_big "$2"; else tmux set -pu -t "$1" @reader_big; fi
  tmux resize-pane -t "$1" -y "$2"
}

small() { height "$1" "$SMALL"; }

# reader or slot $1 in window $2 (its height $3 if above SMALL): if tmux moved it out of place (a layout
# command, a sidebar split in beside it), back across the bottom at full width, that high (SMALL to 2/3)
place() {
  local wide full bottom zoom side rows=${3:-$SMALL} most
  read -r wide full bottom zoom < <(tmux display -p -t "$1" \
    '#{pane_width} #{window_width} #{pane_at_bottom} #{window_zoomed_flag}')
  (( wide < full )) || [[ $bottom != 1 ]] || return 0
  side=$(sidebar "$2")
  # no sidebar yet: tabrail-tmux ensure follows once it has one; zoomed: joining would unzoom the tab
  [[ -n $side && $zoom == 0 ]] || return 0
  most=$(tall "$2"); (( rows > most )) && rows=$most; (( rows < SMALL )) && rows=$SMALL
  tmux join-pane -fv -d -l "$rows" -s "$1" -t "$side"
}

# WINDOW: small while its own pane is active, else the height it has (@reader_big, at most 2/3); the
# keyboard alone never grows it. Its place and size are applied again either way (after a resize, tmux
# spreads rows; a layout command spreads the bar too). A tab without the bar: its slot, always small.
fit() {
  local r rwin isbig zoom active most
  read -r r rwin isbig < <(reader)
  [[ $rwin == "$1" ]] || { r=$(slot "$1") isbig=; }
  [[ -n $r ]] || return
  read -r zoom active < <(tmux display -p -t "$1" \
    '#{window_zoomed_flag} #{?@reader,reader,#{?@sidebar,sidebar,work}}')
  [[ $zoom == 1 ]] && return   # resizing would unzoom the tab
  place "$r" "$1" "$isbig"
  most=$(tall "$1")
  if (( ${isbig:-0} > SMALL )) && [[ $active != work ]]; then height "$r" $(( isbig < most ? isbig : most ))
  else small "$r"; fi
}

# PANE ROWS|up|down from tabrail-chat in the bar: ROWS its own height (SMALL up to a third of the
# window), up and down a sixth of the window more or less (SMALL up to 2/3). Only while PANE is the
# reader and its tab's active pane, and the tab is not zoomed.
size() {
  local r rwin isbig act zoom h wh most
  read -r r rwin isbig < <(reader)
  [[ -n $r && $r == "$1" && $2 =~ ^([0-9]+|up|down)$ ]] || return
  read -r act zoom < <(tmux display -p -t "$r" '#{pane_active} #{window_zoomed_flag}')
  [[ $act == 1 && $zoom == 0 ]] || return
  place "$r" "$rwin" "$isbig"
  read -r h wh < <(tmux display -p -t "$r" '#{pane_height} #{window_height}')
  most=$(( wh * 2 / 3 ))
  case $2 in
    up) h=$(( h + wh / 6 )) ;;
    down) h=$(( h - wh / 6 )) ;;
    *) h=$(( 10#$2 )) most=$(( wh / 3 )) ;;
  esac
  (( h > most )) && h=$most
  (( h < SMALL )) && h=$SMALL
  height "$r" "$h"
}

grow() { :; }   # old double-click bindings (a tmux.conf not patched yet, a server not reloaded): nothing
