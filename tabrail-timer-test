#!/usr/bin/env bash
# Tests for the group timers in the sidebar (src/timer.rs, head.rs, the group menu) on throwaway tmux
# servers (tabrail-test-lib), state in the temp dir's XDG_STATE_HOME: the menu's items (Default's too,
# none and no ▷ for a name clean() changes), start, stop, resume and reset by right-click, the time's
# colour, two groups, a second session, rename, folded, kill-server (a stopped value back, a running
# one counts the time down), a narrow sidebar, a garbled file, a group's last tab closed. The state
# file alone: tabrail-timer-state-test. One line per check, exits 1 if one failed.
L=timer
source "$(dirname "$(readlink -f "$0")")/tabrail-test-lib"
F=$T/state/tabrail/timers W=Website   # XDG_STATE_HOME=$T/state: tabrail-test-lib
mkdir "$T/web" "$T/infra" "$T/long" "$T/dirty"
printf '%s\n' "$W #283147 ◆ $T/web" "Infra #3b2f2a ▲ $T/infra" \
  "Abcdefghijklmnopqrstuvwxyz0123 #2a3b2f ● $T/long" "Q'a #3b2a3a ■ $T/dirty" > "$T/groups.conf"
echo "set -g @tabrail_groups '$T/groups.conf'" >> "$T/conf"
up() {   # tabs in work (Default), web, infra, long, dirty; main shown in the outer server
  local d; inner; for d in web infra long dirty; do t new-window -d -c "$T/$d"; done
  o -f /dev/null new -d -s o -x 160 -y 46 "TMUX= tmux -L tabrail-$L attach -t main; sleep 600"
  o set -g status off; settle 3
}
down() { t kill-server; o kill-server; sleep 0.5; }
nf=$'\uEB2C'   # head.rs START, shown here as ▷
bar() { t capture-pane -p -t "$(side "${2:-main:1}")" | grep -m1 -- "$1" | sed "s/$nf/▷/g"; }   # a sidebar's row with TEXT
shown() { o capture-pane -p -t o:0 | sed "s/$nf/▷/g"; }                    # tab 1 of main, menus too
menu() {   # right-click a group's row, menu open
  local y; y=$(shown | grep -n -m1 -- "$1" | cut -d: -f1)
  o send-keys -t o:0 -l $'\e[<2;5;'"$y"M; o send-keys -t o:0 -l $'\e[<2;5;'"$y"m; settle 0.7
}
pick() { o send-keys -t o:0 -l "$1"; settle; }                              # a menu item by its key
num() { grep -oE '[▶⏸] [0-9]+s' <<<"$1" | tr -dc 0-9; }                    # seconds a label shows
line() { grep "^$1 " "$F"; }
f() { line "$1" | cut -d' ' -f"$2"; }                                       # field N of GROUP's line
run() { TMUX=$(t display -p '#{socket_path}'),0,0 "$R/tabrail-timer" "$@"; }   # as a menu item would
bad='[[;](0|22|49)m'                                                       # reset, bold off, tint off
up

menu "◆ $W"; m=$(shown)
check "a group with no time: Start timer, no Reset timer" '[[ $m == *"Start timer"* && $m != *"Reset timer"* ]]'
pick t; a=$(bar "◆ $W"); l=$(line $W); st=${l##* }
check "Start timer: line '$l', ▶ and the time after the name" \
  '[[ $l =~ ^$W\ 0\ [0-9]{10}$ && $a =~ ^"▾ ◆ $W ▶ "[0-9]+s ]]'
e=$(t capture-pane -ep -t "$(side main:1)" | grep -m1 -- "◆ $W"); e=${e#*"◆ $W"}; e=${e%%▶*}
check "busy colour right before ▶; tint and bold go on past the name" '[[ $e == *"249;226;175m" && ! $e =~ $bad ]]'
sleep 2; b=$(bar "◆ $W")
check "the running time grows ($(num "$a") s -> $(num "$b") s)" '(( $(num "$b") >= $(num "$a") + 2 ))'
menu "• Default"; m=$(shown); pick t
check "Default: Start timer in its menu, and it runs" '[[ $m == *"Start timer"* && $(bar "• Default") == *"▶ "* ]]'
menu "■ Q'a"; m=$(shown); pick q
check "a name clean() changes: a menu without timer items, no ▷" '[[ $m == *Fold* && $m != *timer* && $(bar "■ Q") != *▷* ]]'

t new -d -s two -c "$T/web"; o new-window -d "TMUX= tmux -L tabrail-$L attach -t two; sleep 600"; settle 2
menu "◆ $W"; m=$(shown)
check "running: Stop timer and Reset timer" '[[ $m == *"Stop timer"* && $m == *"Reset timer"* ]]'
s=$EPOCHSECONDS; pick t; a=$(bar "◆ $W"); sleep 3; b=$(bar "◆ $W"); l=$(line $W); acc=$(f $W 2)
check "Stop timer: '$l', the $((s - st)) s or more it ran; header frozen at ⏸ over 3 s" \
  '[[ $l =~ ^$W\ [0-9]+\ 0$ && $a == "$b" && $a == *"⏸ "* ]] && (( acc >= s - st && acc <= EPOCHSECONDS - st ))'
check "a second session's sidebar shows the same time" '[[ $(bar "◆ $W" two:1) == "$a" ]]'
menu "◆ $W"; pick t; st=$(f $W 3)
check "Start timer again: resumes from $acc s" '[[ $(line $W) =~ ^$W\ $acc\ [0-9]{10}$ && $(bar "◆ $W") == *"▶ "* ]]'
t kill-session -t two; o kill-window -t o:1

menu "▲ Infra"; pick t; s=$EPOCHSECONDS; menu "◆ $W"; pick t
check "two groups: Infra runs on, Website stopped" \
  '[[ $(line Infra) =~ \ [0-9]{10}$ && $(line $W) =~ \ 0$ && $(bar "▲ Infra") == *"▶ "* && $(bar "◆ $W") == *"⏸ "* ]]'
check "Stop again adds the $((s - st)) s or more since to $acc s: $(f $W 2) s" '(( $(f $W 2) >= acc + s - st ))'
v=$(line Infra | cut -d' ' -f2-); t run-shell "$R/tabrail-act rename-group Infra Ops"; settle
check "Rename group Infra to Ops: the timer follows" '[[ $(line Ops) == "Ops $v" && -z $(line Infra) && $(bar "▲ Ops") == *"▶ "* ]]'
t run-shell "$R/tabrail-act fold Ops"; settle
check "folded: the time, then the count ($(bar "▲ Ops"))" '[[ $(bar "▲ Ops") =~ ^"▸ ▲ Ops ▶ "[0-9]+s"  1 tab"$ ]]'

a=$(bar "◆ $W"); b=$(bar "▲ Ops"); down; sleep 4; up
check "kill-server, new server: the stopped time is back" '[[ $(bar "◆ $W") == "$a" ]]'
c=$(bar "▲ Ops")
check "the running one counted the 4 s down ($(num "$b") s -> $(num "$c") s)" '(( $(num "$c") >= $(num "$b") + 4 ))'

menu "◆ $W"; pick 0; menu "◆ $W"; m=$(shown); pick q
check "Reset timer: line gone, no time, the ▷ back, no Reset timer in the menu" \
  '[[ -z $(line $W) && $(bar "◆ $W") != *[▶⏸]* && $(bar "◆ $W") == *" ▷" && $m == *"Start timer"* && $m != *"Reset timer"* ]]'

echo "Abcdefghijklmnopqrstuvwxyz0123 0 $((EPOCHSECONDS - 7200))" >> "$F"
t resize-pane -t "$(side main:1)" -x 26; settle 2; a=$(bar "● ")
t run-shell "$R/tabrail-act fold Abcdefghijklmnopqrstuvwxyz0123"; settle
check "width 26, a 30-character name running 2h: name cut, time whole; folded, no count" \
  '[[ $a == "▾ ● Abcdefghijklmno ▶ 2h0m" && $(bar "● ") == "▸ ● Abcdefghijklmno ▶ 2h0m" ]]'

printf 'garbage here\n\377\001 junk\nX -1 0\nOps 1 2 3\n' >> "$F"; settle
check "a garbled file, a non-UTF-8 byte: the sidebar draws, the good lines show" \
  '[[ $(bar "▲ Ops") == *"▶ "* && -n $(bar "◆ $W") && -n $(bar "● ") ]]'

run start $W; t kill-window -t main:2; settle; a=$(bar "◆ $W"); sleep 2; b=$(bar "◆ $W")
r=$(t capture-pane -p -t "$(side main:1)" | grep -A1 -m1 -- "◆ $W" | tail -1)
check "last tab closed: the header stays, no tab rows, counting ($(num "$a") s -> $(num "$b") s)" \
  '[[ $a == "▾ ◆ $W ▶ "* && -z $r ]] && (( $(num "$b") >= $(num "$a") + 2 ))'
menu "◆ $W"; m=$(shown); pick t
check "its menu's Stop timer stops it" '[[ $m == *"Stop timer"* && $(line $W) =~ \ 0$ && $(bar "◆ $W") == *"⏸ "* ]]'
menu "◆ $W"; pick 0
check "Reset timer, no tabs: the header is gone" '[[ -z $(bar "◆ $W") ]]'
exit $((fails > 0))
