#!/usr/bin/env bash
# Housekeeping for tabrail, the tmux sidebar (target/release/tabrail, built from src/ with cargo),
# called from tabrail.tmux hooks and by hand; what its menus do is in tabrail-act:
#   ensure [WINDOW]  give every tab (or WINDOW) a sidebar pane on the left, and a group by its folder
#   refresh          make every sidebar redraw now
#   restart          restart every sidebar (after cargo build)
#   reap             close tabs where only the sidebar (and the reader pane or its slot) is left
#   close WINDOW     close a tab; the reader pane moves on first (the menus' Close)
#   group DIR        print the group of a folder
# The reader pane and its slots (tabrail-reader) only when the global option @tabrail_reader names
# its command.
D=$(dirname "$(readlink -f "$0")")
CONF=$(tmux show -gv @tabrail_groups 2>/dev/null)   # the groups: the file tmux.conf names, else ours
CONF=${CONF:-$D/groups.conf}
WIDTH=$(tmux show -gv @sidebar_width 2>/dev/null)   # one width for every sidebar (src/width.rs)
[[ $WIDTH =~ ^[0-9]+$ ]] || WIDTH=26

# Every sidebar's control connection reports a changed paste buffer at once (%paste-buffer-changed),
# so touching a named one is the cheapest way to make the shown sidebar redraw (hidden ones draw when
# their tab is shown)
refresh() { tmux set-buffer -b sidebar-refresh x 2>/dev/null; true; }
reader() { [[ -n $(tmux show -gv @tabrail_reader 2>/dev/null) ]] && "$D/tabrail-reader" "$@"; true; }

group() {
  local name tint icon dir
  while read -r name tint icon dirs; do
    [[ -z $name || $name == \#* ]] && continue
    for dir in $dirs; do
      dir=${dir/#\~/$HOME}
      [[ $1 == "$dir" || $1 == "$dir"/* ]] && { echo "$name"; return; }
    done
  done < "$CONF"
  echo Default
}

ensure() {
  # During a restore (resurrect) tabs come back one by one, their saved sidebars and slots with them:
  # wait until it is done, and a moment for the restored ones to start ([t] keeps pgrep off this script)
  local win id
  if pgrep -f '[t]mux-resurrect/scripts/restore.sh' >/dev/null; then
    while pgrep -f '[t]mux-resurrect/scripts/restore.sh' >/dev/null; do sleep 0.5; done
    sleep 2
  fi
  exec 9> "/tmp/tabrail-$UID.lock"   # one ensure at a time, or two can add a sidebar each
  flock 9
  for win in ${1:-$(tmux list-windows -a -F '#{window_id}')}; do
    if [[ -z $(tmux show -wv -t "$win" @group 2>/dev/null) ]]; then
      tmux set -w -t "$win" @group "$(group "$(tmux display -p -t "$win" '#{pane_current_path}')")"
    fi
    if ! tmux list-panes -t "$win" -F '#{@sidebar}' | grep -q 1; then
      id=$(tmux split-window -hbf -d -l "$WIDTH" -t "$win" -P -F '#{pane_id}' "$D/target/release/tabrail")
      [[ -n $id ]] && tmux set -p -t "$id" @sidebar 1   # never mark the tab's own pane
    fi
  done
  refresh
  if [[ -z $(tmux show -gv @tabrail_reader 2>/dev/null) ]]; then   # slots only while it is set
    tmux list-panes -a -f '#{@reader_slot}' -F '#{pane_id}' | xargs -rn1 tmux kill-pane -t
  fi
  reader slots "$1"
  reader follow
}

restart() {
  local id
  for id in $(tmux list-panes -a -F '#{pane_id} #{@sidebar}' | awk '$2 == 1 { print $1 }'); do
    tmux respawn-pane -k -t "$id" "$D/target/release/tabrail"
  done
}

reap() {
  local win
  for win in $(tmux list-windows -a -F '#{window_id}'); do
    tmux list-panes -t "$win" -F '#{@sidebar}#{@reader}#{@reader_slot}' | grep -qv 1 || close "$win"
  done
  reader slots   # a tab whose reader ended gets its slot back
  reader follow   # it moves to the tab shown now, or starts again if it was the pane that ended
}

close() {
  reader away "$1"
  tmux kill-window -t "$1" 2>/dev/null
  true   # run-shell -b shows a failure in the pane
}

case $1 in
  ensure | refresh | restart | reap | close | group) "$@" ;;
  *) echo "usage: tabrail-tmux ensure [WINDOW] | refresh | restart | reap | close WINDOW | group DIR" >&2
     exit 2 ;;
esac
