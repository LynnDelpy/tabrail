#!/usr/bin/env bash
# Tests for nested groups (src/groups.rs, draw.rs, row.rs, head.rs; tabrail-groups, tabrail-move) on
# throwaway tmux servers (tabrail-test-lib), the groups file a symlink to a temp file that
# @tabrail_groups names: a flat file drawn as main draws it and a drag still moving its line, the tree
# one column in per level, a click on a nested row, a folded parent counting its tree, a subgroup's
# fold kept, an empty leaf, an indented first line, tabrail-groups tree, a timer on a tab-less
# subgroup, Move to group… listing the tree and a tab moved into a subgroup in every sidebar, a parent
# without tabs, Rename group from the menu keeping the indent. One line per check, exits 1 if one failed.
L=tree
source "$(dirname "$(readlink -f "$0")")/tabrail-test-lib"
mkdir "$T/real"; F=$T/real/groups.conf
printf '%s\n' "# Project groups" "Website   #283147  ◆  ~/src/website ~/src/website-staging" \
  "Infra     #3b2f2a  ▲  ~/src/infra" "Notes     #2a3b2f  ●" > "$F"   # groups.conf.example before nesting
chmod 640 "$F"; ln -s "$F" "$T/groups.conf"
sed -i '/@tabrail_reader/d' "$T/conf"   # no reader bar: not what this tests
echo "set -g @tabrail_groups '$T/groups.conf'" >> "$T/conf"
inner; t rename-window -t main:1 home
for n in core sg arch; do t new-window -d -n "$n" -c "$T/work"; done
o -f /dev/null new -d -s o -x 160 -y 46 "TMUX= tmux -L tabrail-$L attach -t main; sleep 600"
o set -g status off; settle 3
nf=$'\uEB2C'   # head.rs START, dropped with the spaces before it and the + after it
# a sidebar's rows (main:1's by default) joined by |, without the clock and the empty rows below
bar() { t capture-pane -p -t "$(side "${1:-main:1}")" | head -n -1 | sed "s/ *$nf\( +\)\{0,1\}$//" | tr '\n' '|' | sed 's/|*$//'; }
grp() { t set -w -t "main:$1" @group "$2"; }
redraw() { t set-buffer -b sidebar-refresh x; settle; }
sgr() { o send-keys -t o -l $'\e[<'"$1;5;$2$3"; }   # BUTTON (0 left, 32 a drag) at column 5, ROW, M|m
drg() { sgr 0 "$1" M; sgr 32 "$2" M; sgr 0 "$2" m; settle; }   # from row to row
menu() { local y; y=$(o capture-pane -p -t o | grep -n -m1 -- "$1" | cut -d: -f1); sgr 2 "$y" M; sgr 2 "$y" m; settle 0.7; }
keys() { o send-keys -t o -l "$1"; settle "${2:-1}"; }   # typed into the menu or popup
key() { o send-keys -t o "$1"; settle "${2:-1.5}"; }
tree=("egov      #283147  ★" "  St.Gallen  #2a3b2f  ✚" "    Archiv  #3b2a3a  ◆")
nested() { printf '%s\n' "${tree[@]}" > "$F"; grp core egov; grp sg St.Gallen; grp arch Archiv; redraw; }

grp core Website; grp sg Website; grp arch Infra; t set -g @sidebar_fold Infra; redraw
check "flat: as main draws it ($(bar))" '[[ $(bar) == "|▾ Website|   core|   sg||▸ Infra  1 tab||▾ Default| ❯ home" ]]'
drg 6 3   # on Website's tab: its header's name (from column 3) would nest Infra (tabrail-tree-drag-test)
check "flat: Infra's row dragged onto Website's tab moves its line above (tabrail-groups), still a link, 640" \
  '[[ $(grep -v "^#" "$F" | head -1) == Infra* && -L $T/groups.conf && $(stat -c %a "$F") == 640 ]]'

t set -g @sidebar_fold ''; nested
want="|▾ egov|   core| ▾ St.Gallen|    sg|  ▾ Archiv|     arch||▾ Default| ❯ home"
check "nested: headers at columns 1, 2, 3, tabs in by their group's depth, one blank line after Archiv's tab" \
  '[[ $(bar) == "$want" ]]'
click 20 7; at=$(t display -p -t main '#{window_name}'); t select-window -t main:1; settle
check "a click on Archiv's tab row (row 7) goes to it ($at)" '[[ $at == arch ]]'
click 5 2; f=$(t show -gv @sidebar_fold)
check "egov's header clicked: folded, its tree's 3 tabs counted, then the blank line ($(bar))" \
  '[[ $f == egov && $(bar) == "|▸ egov  3 tabs||▾ Default| ❯ home" ]]'
click 5 2; click 5 4; click 5 2; click 5 2
check "St.Gallen folded, egov folded and unfolded: St.Gallen still folded, 2 tabs ($(bar))" \
  '[[ $(bar) == "|▾ egov|   core| ▸ St.Gallen  2 tabs||▾ Default| ❯ home" ]]'
t set -g @sidebar_fold ''; grp arch Default; redraw
check "empty leaf: no Archiv header ($(bar))" '[[ $(bar) == "|▾ egov|   core| ▾ St.Gallen|    sg||▾ Default| ❯ home|   arch" ]]'
printf '%s\n' "   egov #283147 ★" "  St.Gallen #2a3b2f ✚" "    Archiv #3b2a3a ◆" > "$F"; grp arch Archiv; redraw
check "first group line indented: top-level, St.Gallen too, Archiv under St.Gallen ($(bar))" \
  '[[ $(bar) == "|▾ egov|   core||▾ St.Gallen|   sg| ▾ Archiv|    arch||▾ Default| ❯ home" ]]'
printf '%s\n' "egov #1 ★" "  # customers of egov" "	St.Gallen #2 ✚" "	 Archiv #3 ◆" " Köniz #4 ✚" > "$F"
got=$(TMUX="$(sock),0,0" "$R/tabrail-groups" tree | tr '\t\n' ' |')
check "tabrail-groups tree: a tab or a space one column each, an indented # a comment ($got)" '[[ $got == "0 egov ★|1 St.Gallen ✚|2 Archiv ◆|1 Köniz ✚|" ]]'
printf '%s\n' "${tree[@]}" > "$F"; for w in core sg arch; do grp "$w" Default; done
t run-shell "$R/tabrail-timer start St.Gallen"; redraw
check "a timer on tab-less St.Gallen under tab-less egov: both headers, its time ($(bar))" \
  '[[ $(bar) == "|▾ egov| ▾ St.Gallen ▶ "* ]]'
t run-shell "$R/tabrail-timer reset St.Gallen"

nested; c=$(t list-clients -f '#{!:#{client_control_mode}}' -F '#{client_name}')
t run-shell -b "$R/tabrail-move $(win main:core) '$c'"; settle 2; p=$(o capture-pane -p -t o)
check "Move to group…: the tree in order, St.Gallen under egov, indented" \
  '[[ $p == *"1. egov  1 tab · current"*"2.  St.Gallen  1 tab"*"3.   Archiv  1 tab"*"4. Default  1 tab"* ]]'
o send-keys -t o 3; settle
for w in home core sg arch; do
  t select-window -t "main:$w"; settle 1.2; got=$(bar "main:$w" | sed 's/❯/ /')
  check "core moved into Archiv: $w's sidebar shows it under Archiv's header, 2 in" \
    '[[ $got == "|▾ egov| ▾ St.Gallen|    sg|  ▾ Archiv|     core|     arch||▾ Default|   home" ]]'
done
t select-window -t main:1; settle
check "parent without tabs: egov's header, then St.Gallen's" '[[ $(bar) == "|▾ egov| ▾ St.Gallen|    sg|"* ]]'

cp "$F" "$T/before"; menu "[▾▸] St.Gallen"; keys r 1.5; key C-u 0.3; keys SG; key Enter 2
d=$(diff "$T/before" "$F" | grep '^[<>]' | tr '\n' '|')
check "Rename group from the menu, St.Gallen to SG: only the name changed, indent and spacing kept ($d)" \
  '[[ $d == "<   St.Gallen  #2a3b2f  ✚|>   SG  #2a3b2f  ✚|" ]]'
check "rename: still a link, 640, no temp file; sg's tab in SG, shown one in" \
  '[[ -L $T/groups.conf && $(stat -c %a "$F") == 640 && -z $(ls "$T/real" | grep new) &&
     $(t show -wv -t main:sg @group) == SG && $(bar) == "|▾ egov| ▾ SG|    sg|"* ]]'
exit $((fails > 0))
